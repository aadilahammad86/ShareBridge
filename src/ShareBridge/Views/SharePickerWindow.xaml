<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ShareBridge.Views.SharePickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Share Bridge"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Content Preview Card -->
            <RowDefinition Height="*" />    <!-- Adapter List -->
            <RowDefinition Height="Auto" /> <!-- Status / Cancel Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Vertical" Spacing="4">
                <TextBlock
                    Text="Share with"
                    Style="{ThemeResource TitleTextBlockStyle}"
                    FontSize="22"
                    FontWeight="SemiBold" />
                <TextBlock
                    Text="Choose destination app"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Content Preview Card -->
        <Border
            Grid.Row="1"
            Padding="14,12"
            Margin="0,0,0,16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <FontIcon
                    x:Name="PreviewIcon"
                    Grid.Column="0"
                    Glyph="&#xE8B9;"
                    FontSize="24"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                <!-- Text info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="PreviewTitle"
                        Text="Loading shared content..."
                        FontWeight="Medium"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1" />
                    <TextBlock
                        x:Name="PreviewDetail"
                        Text="Preparing items..."
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Adapter Selection Area -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="AdaptersPanel" Spacing="8">
                <!-- Dynamically populated adapter buttons -->
            </StackPanel>
        </ScrollViewer>

        <!-- Footer / Cancel Button -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <ProgressBar
                x:Name="ActionProgressBar"
                IsIndeterminate="True"
                Visibility="Collapsed"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                Width="160" />

            <Button
                x:Name="CancelButton"
                Content="Cancel"
                HorizontalAlignment="Right"
                Click="OnCancelClick"
                Style="{ThemeResource DefaultButtonStyle}"
                CornerRadius="8"
                Padding="16,6" />
        </Grid>
    </Grid>
</Window>
