<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ShareBridge.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" Margin="32,24,32,32" Spacing="24">

            <!-- Hero Section -->
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72D;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Share Bridge" Style="{ThemeResource TitleLargeTextBlockStyle}" FontWeight="Bold" />
                </StackPanel>
                <TextBlock
                    Text="Bridges traditional desktop applications and browser shortcuts directly into the native Windows 11 Share flyout."
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                
                <!-- Offline Badge -->
                <Border
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,4"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock Text="100% Offline • Zero Telemetry" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Medium" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Instructions Card -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="How to Use" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock
                        Text="1. Right-click any file, picture, or document in File Explorer."
                        Style="{ThemeResource BodyTextBlockStyle}" />
                    <TextBlock
                        Text="2. Click the native Windows 'Share' icon in the context menu."
                        Style="{ThemeResource BodyTextBlockStyle}" />
                    <TextBlock
                        Text="3. Choose 'Share Bridge' from the target list."
                        Style="{ThemeResource BodyTextBlockStyle}" />
                    <TextBlock
                        Text="4. Select Telegram Desktop, WhatsApp Web, or Clipboard to immediately dispatch your content."
                        Style="{ThemeResource BodyTextBlockStyle}" />
                </StackPanel>
            </Border>

            <!-- Detected Adapters Card -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20">
                <StackPanel Spacing="16">
                    <Grid>
                        <TextBlock Text="Available Target Adapters" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                        <Button Content="Refresh" HorizontalAlignment="Right" Click="OnRefreshClick" Style="{ThemeResource SubtleButtonStyle}" />
                    </Grid>

                    <StackPanel x:Name="AdaptersListPanel" Spacing="10">
                        <!-- Dynamically populated in code-behind -->
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Maintenance & Actions Card -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Actions &amp; Testing" FontWeight="SemiBold" FontSize="16" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            x:Name="TestPickerButton"
                            Content="Test Share Picker"
                            Click="OnTestPickerClick"
                            Style="{ThemeResource AccentButtonStyle}"
                            CornerRadius="8"
                            Padding="16,8" />

                        <Button
                            x:Name="ClearTempButton"
                            Content="Clean Stale Temp Files"
                            Click="OnCleanTempClick"
                            CornerRadius="8"
                            Padding="16,8" />

                        <Button
                            x:Name="CheckUpdatesButton"
                            Content="Check for Updates"
                            Click="OnCheckUpdatesClick"
                            CornerRadius="8"
                            Padding="16,8">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                                        <TextBlock Text="Check for Updates" />
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="InstalledVersionText" Text="Installed Version: ..." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="UpdateStatusText" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                        <HyperlinkButton x:Name="UpdateDownloadLink" Visibility="Collapsed" NavigateUri="https://github.com/aadilahammad86/ShareBridge/releases" Padding="0" Content="Download in Browser" />
                    </StackPanel>

                    <!-- Inline Download and Installation Progress -->
                    <StackPanel x:Name="UpdateProgressPanel" Visibility="Collapsed" Spacing="6" Margin="0,4,0,0">
                        <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100" Value="0" HorizontalAlignment="Stretch" Height="6" CornerRadius="3" />
                        <TextBlock x:Name="UpdateProgressDetails" Text="Downloading update..." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock
                        x:Name="StatusMessage"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

    <!-- Tinted Full-Window Background Restart Overlay -->
    <Grid x:Name="UpdateRestartOverlay"
          Visibility="Collapsed"
          Background="#D90B0F19"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="36,32"
                MaxWidth="460"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="20" HorizontalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="36" Background="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE896;" FontSize="32" Foreground="White" />
                </Border>
                <StackPanel Spacing="8">
                    <TextBlock Text="Update Ready!" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="UpdateRestartSubtitle"
                               Text="Share Bridge has been updated in the background. Restart now to apply the new version."
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="RestartAppButton"
                        Content="Restart Share Bridge"
                        Click="OnRestartAppClick"
                        Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Padding="32,10"
                        CornerRadius="8"
                        FontSize="15"
                        FontWeight="SemiBold" />
            </StackPanel>
        </Border>
    </Grid>
</Grid>
</Page>
